# copy to .env (or set in your host's dashboard) — NEVER commit real values
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-password
PORT=5000
DATABASE_PATH=/data/counselling.db        # persistent location for SQLite
FLASK_SECURE_COOKIES=1                    # 1 when served over HTTPS
MAX_UPLOAD_MB=10
WEB_CONCURRENCY=2
WEB_THREADS=4
